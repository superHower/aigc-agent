OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_EDIT=gpt-image-2.5-sunburst
MODEL_DRAFT=gpt-image-2.5-flare
MAX_CONCURRENCY=10
# Cross-task image limits, applied together with each channel's capacity (single backend process).
USER_CONCURRENCY=1
MEMBER_CONCURRENCY=3
REQUEST_TIMEOUT=300
JOB_TIMEOUT=360
MAX_RETRIES=2

# v4: leave DATABASE_URL empty for local SQLite. Production uses PostgreSQL.
DATABASE_URL=
POSTGRES_PASSWORD=
# Set true behind HTTPS. Login is required for every business API.
COOKIE_SECURE=false
# SMS defaults to disabled. Test delivery is only allowed with APP_ENV=development.
APP_ENV=production
# Alipay AI 网页应用收款（沙箱/生产均由环境变量注入，勿提交私钥）
ALIPAY_MOCK=true
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_RETURN_URL=http://localhost:8000/api/alipay/return
ALIPAY_NOTIFY_URL=http://localhost:8000/api/alipay/notify
SMS_MODE=disabled
SMS_TEST_OUTBOX=
# HTTPS gateway adapter: POST phone/purpose/code/request_id; response {"accepted":true}.
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
