OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_EDIT=gpt-image-2.5-sunburst
MODEL_DRAFT=gpt-image-2.5-flare
MAX_CONCURRENCY=10
REQUEST_TIMEOUT=300
JOB_TIMEOUT=360
MAX_RETRIES=2

# NATAPP tunnel token (leave empty to disable the tunnel)
NATAPP_AUTHTOKEN=
